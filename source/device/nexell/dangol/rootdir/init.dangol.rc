# SPDX-License-Identifier: Apache-2.0
# Project init policy using measured nodes and public Android init contracts.
import /init.dangol.usb.rc
on early-init
    mkdir /mnt/media_rw 0750 media_rw media_rw
on init
    chmod 0666 /dev/mali
    chown system graphics /dev/mali
    chmod 0666 /dev/ion
    chown system graphics /dev/ion
on fs
    mount_all /fstab.dangol --early
on late-fs
    mount_all /fstab.dangol --late
on post-fs-data
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/bluetooth 0770 bluetooth net_bt_stack
on boot
    setprop ro.sf.lcd_density 160
    chmod 0660 /sys/class/backlight/pwm-backlight/brightness
    chown system system /sys/class/backlight/pwm-backlight/brightness
on property:sys.boot_completed=1
    write /sys/class/backlight/pwm-backlight/brightness 128
