# SPDX-License-Identifier: Apache-2.0
# Project Android 9 service wiring for the measured BCM43438/AP6212 hardware.
on post-fs-data
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    insmod /system/lib/modules/bcmdhd.ko firmware_path=/system/vendor/firmware/fw_bcm43438a1.bin nvram_path=/system/vendor/firmware/nvram_ap6212.txt iface_name=wlan0

service wpa_supplicant /vendor/bin/hw/wpa_supplicant -Dnl80211 -O/data/vendor/wifi/wpa/sockets -e/data/vendor/wifi/wpa/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
