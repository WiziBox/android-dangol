     switch (what) {
         case MessageQueue::INVALIDATE: {
-            bool frameMissed = !mHadClientComposition &&
+            // HWC1 retire fences can signal only after the NEXT presentation.
+            // The HWC2 adapter explicitly declares these timestamps unreliable.
+            // On this legacy Intel device, using that fence to prevent the next
+            // presentation creates a circular wait. Keep all acquire/release
+            // synchronization intact; do not treat a retire fence as present.
+            static const bool acerLegacyDisplay = [] {
+                char device[PROPERTY_VALUE_MAX] = {};
+                property_get("ro.product.device", device, "");
+                return !strcmp(device, "ducati2fhd");
+            }();
+            const bool unreliableLegacyPresent = acerLegacyDisplay &&
+                    getHwComposer().hasCapability(HWC2::Capability::PresentFenceIsNotReliable);
+            bool frameMissed = !unreliableLegacyPresent && !mHadClientComposition &&
                     mPreviousPresentFence != Fence::NO_FENCE &&
                     (mPreviousPresentFence->getSignalTime() ==
                             Fence::SIGNAL_TIME_PENDING);
