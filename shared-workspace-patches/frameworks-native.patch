+    // Intel's KitKat EGL queues the current framebuffer and dequeues the
+    // next one inside eglSwapBuffers, before this thread advances the consumer.
+    // Two total slots leave one ACQUIRED and one QUEUED, causing self-deadlock.
+    // Preserve buffer ownership/fences; reserve the third slot only on Acer.
+    char acerDevice[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.product.device", acerDevice, "");
+    if (!strcmp(acerDevice, "ducati2fhd") && maxFrameBufferAcquiredBuffers < 3) {
+        maxFrameBufferAcquiredBuffers = 3;
+        ALOGI("Acer Intel EGL: three framebuffer slots for queue-before-dequeue");
+    }
+
